# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo


# credentials — belt and braces. The app stores its token in the device
# keychain and never writes it to disk, but never let one in by accident.
.env
*.token
secrets.json

# ── Native projects are tracked (Xcode Cloud needs the scheme in git) ──
# but everything generated, machine-specific or credential-bearing is not.

# Dependency trees — reinstalled by CI, 600MB+ locally
ios/Pods/

# Build output
ios/build/
ios/DerivedData/
android/build/
android/app/build/
android/.gradle/
android/.cxx/

# Machine-specific: absolute paths that break on any other machine
ios/.xcode.env.local
android/local.properties

# Per-user Xcode state (window layout, breakpoints, unshared schemes)
**/xcuserdata/
*.xcuserstate

# Signing material — never track any of it, including debug keystores.
# The RN debug keystore is a well-known public key, but it regenerates
# automatically and there is no reason to carry key material in a repo.
*.keystore
*.jks
*.p12
*.p8
*.cer
*.certSigningRequest
*.mobileprovision
*.provisionprofile

# Google service configs (not used today; guard against a future addition)
google-services.json
GoogleService-Info.plist

# EAS
.easignore
